---
import { Home, User, Code, GitCompare } from '@lucide/astro';

const url = Astro.url.pathname;

let currentTab: 'about' | 'projects' | 'home' = 'home';

if (url === '/about') {
  currentTab = 'about';
} else if (url === '/projects') {
  currentTab = 'projects';
} else if (url === '/') {
  currentTab = 'home';
}

const tabs = [
  { name: 'home', href: '/', icon: Home },
  { name: 'about', href: '/about', icon: User },
  { name: 'projects', href: '/projects', icon: Code },
];
---

<nav id="bufferline">
  <row id="tabs">
    {tabs.map(tab => {
      const IconComponent = tab.icon;
      return (
        <a
          href={tab.href}
          class="tab"
          data-active={currentTab === tab.name}
          target={tab.external ? "_blank" : undefined}
        >
          <IconComponent class="tab-icon" size={20} />
          <span class="tab-name">{tab.name}</span>
          <span class="tab-modified"></span>
        </a>
      );
    })}
  </row>
</nav>

<style>
  #bufferline {
    display: flex;
    background-color: var(--background0);
    border-bottom: 1px solid var(--surface1);
    overflow-x: auto;
    scrollbar-width: none;
  }

  #bufferline::-webkit-scrollbar {
    display: none;
  }

  #tabs {
    display: flex;
    flex-direction: row;
    gap: 0;
    flex-wrap: nowrap;
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    padding: 0.5lh 1.5ch;
    text-decoration: none;
    color: var(--foreground2);
    background-color: var(--background1);
    border-right: 1px solid var(--surface1);
    white-space: nowrap;
    transition: background-color 0.15s, color 0.15s;
    position: relative;
  }

  .tab:first-child {
    border-left: 1px solid var(--surface1);
  }

  .tab:hover {
    background-color: var(--surface0);
    color: var(--foreground1);
  }

  .tab[data-active="true"] {
    background-color: var(--base);
    color: var(--foreground0);
    font-weight: 500;
    border-bottom: 2px solid var(--blue);
  }

  .tab[data-active="true"]::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--blue);
  }

  .tab-icon {
    color: var(--blue);
    width: 1.2em;
    height: 1.2em;
    display: inline-block;
  }

  .tab[data-active="true"] .tab-icon {
    color: var(--green);
  }

  .tab-name {
    font-size: 0.9em;
  }

  .tab-modified {
    display: none;
  }

  @media (max-width: 54ch) {
    .tab {
      padding: 0.5lh 1ch;
      gap: 0.3ch;
    }

    .tab-name {
      display: none;
    }

    .tab-icon {
      width: 1.4em;
      height: 1.4em;
    }
  }
</style>

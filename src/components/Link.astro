---
interface Props {
  href: string;
  target?: string;
  class?: string;
}

const { href, target, class: className } = Astro.props;
---

<a {href} {target} id="link" class={className}>
  <slot />
</a>

<style>
  #link {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    text-decoration: none;
    font-weight: bold;
    color: var(--foreground1);

    :global(svg) {
      color: #a6e3a1;
      flex-shrink: 0;
    }

    &:focus,
    &:hover {
      text-decoration: underline;
    }
  }
</style>
